# Внутри контейнера работает только HTTP: HTTPS и домен обслуживает внешний nginx на хосте.
{
	auto_https off
	admin off
}

:80 {
	root * /srv
	encode zstd gzip

	# Тяжёлая статика — кэш на месяц
	@static path *.webp *.jpg *.png *.svg *.woff2 *.mp4
	header @static Cache-Control "public, max-age=2592000"

	# HTML/CSS/JS/JSON всегда перепроверяются (замена ручному подъёму ?v=)
	@code path / *.html *.css *.js *.json
	header @code Cache-Control "no-cache"

	# Старый WordPress: адреса из Яндекс Вебмастера (Индексирование → Страницы в поиске), 301 на новые.
	# Новые пары дописывать сюда: redir /old-page/ /new-page 301
	@wp path_regexp ^/(wp-admin|wp-login\.php|wp-content|wp-includes|wp-json|feed|category|tag|author|xmlrpc\.php|20[0-9][0-9])(/|$)
	redir @wp / 301
	@about2 path_regexp ^/about-2/?$
	redir @about2 /about 301
	@pfcase path_regexp pf ^/portfolio/(alfa-dvizh|southhub|alfa-battle|megafon|vtb|kaspersky)/?$
	redir @pfcase /{re.pf.1} 301
	@pf path_regexp ^/portfolio(/|$)
	redir @pf / 301
	# старые кейсы и команда через параметры: /?page=case&case=…, /?cases=…, /?team=…
	@oldpage {
		path /
		query page=*
	}
	redir @oldpage / 301
	@oldmegafon {
		path /
		query cases=megafon
	}
	redir @oldmegafon /megafon 301
	@oldcases {
		path /
		query cases=*
	}
	redir @oldcases / 301
	@oldteam {
		path /
		query team=*
	}
	redir @oldteam / 301

	# Старый лендинг на Тильде lp.median.agency: внешний nginx шлёт его целиком на https://median.agency$request_uri,
	# здесь — адреса Тильды, которых нет на новом сайте (совпадающие /southhub, /abcamp, /megafon… открываются как есть)
	redir /alfadvizh /alfa-dvizh 301
	@lpbattle path /alfabattle2 /alfabatlle /alfa_battle_feedback
	redir @lpbattle /alfa-battle 301
	@lpold path /test /x5techbar /x5techlib /draft_alfa_hrbrand /brandconferences /alfa_test /team_a /nepokaju /magnit /page10799347.html /page10842912.html /page19945618.html /page27795272.html /page27959946.html /live_communications /mts_positioning /mts_block1 /mts_block2_1 /mts_block2_2 /alma_ceramica_case /volkswagen_press_tour /polo_team_vw /conference /moremall_pr_strategy /x5rg /agrashokova /zhazhello /sochievent /itbrandhr /itcamp2 /staff /conferences /conferences_2 /conferences_3 /itcamp /icsp /x5techcampus /swprivef1 /abdigital-fest /mirconf /roadmap /snatchhack /techmn /brief
	redir @lpold / 301

	# Старые «Контакты» → блок контактов на главной
	@contacts path_regexp ^/(contact|contacts|kontakty|contact-us)/?$
	redir @contacts "/#contact" 301
	# /about, /x5stands, /jobs, /vacancy-… → about.html, x5stands.html… (их собирает tools/build-seo.mjs) — отдаются с кодом 200, поисковики их индексируют
	try_files {path} {path}.html {path}/index.html

	file_server

	# Неизвестный адрес отдаёт 404.html (он же перенаправит старые ссылки на кейс).
	handle_errors {
		rewrite * /404.html
		file_server
	}
}
